"""Tests for the Market Intelligence index data service."""

import pandas as pd
import pytest

from data.market_intelligence import index_service as service


def sample_index_data():
    return pd.DataFrame({
        "Date": pd.to_datetime([
            "2026-10-01",
            "2026-10-02",
        ]),
        "Open": [100, 101],
        "High": [103, 104],
        "Low": [99, 100],
        "Close": [102, 103],
        "Volume": [None, None],
        "Symbol": ["^NSEI", "^NSEI"],
        "Source": ["NSE", "NSE"],
        "Exchange": ["NSE", "NSE"],
        "Timeframe": ["1d", "1d"],
        "Fallback Reason": ["", ""],
        "Fetched At UTC": [
            "2026-10-02T10:00:00Z",
            "2026-10-02T10:00:00Z",
        ],
        "Validation Status": ["PASS", "PASS"],
    })


def test_valid_nse_index_data_passes(monkeypatch):
    monkeypatch.setattr(
        service,
        "fetch_market_history",
        lambda **kwargs: sample_index_data(),
    )

    result = service.fetch_index_history(
        "^NSEI", "2026-10-01", "2026-10-02"
    )

    assert len(result) == 2
    assert result["Source"].eq("NSE").all()
    assert result["Validation Status"].eq("PASS").all()


def test_yahoo_fallback_preserves_reason(monkeypatch):
    data = sample_index_data()
    data["Source"] = "Yahoo"
    data["Fallback Reason"] = "NSE unavailable"

    monkeypatch.setattr(
        service,
        "fetch_market_history",
        lambda **kwargs: data,
    )

    result = service.fetch_index_history(
        "^NSEI", "2026-10-01", "2026-10-02"
    )

    assert result["Source"].eq("YAHOO").all()
    assert result["Fallback Reason"].eq(
        "NSE unavailable"
    ).all()


def test_unmapped_index_is_blocked(monkeypatch):
    calls = []

    monkeypatch.setattr(
        service,
        "fetch_market_history",
        lambda **kwargs: calls.append(kwargs),
    )

    with pytest.raises(
        service.MarketIntelligenceDataError,
        match="Unmapped NSE index",
    ):
        service.fetch_index_history(
            "^UNKNOWN", "2026-10-01", "2026-10-02"
        )

    assert calls == []


def test_bse_is_blocked():
    with pytest.raises(
