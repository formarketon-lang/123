def test_duplicate_dates_are_rejected(monkeypatch):
    data = sample_index_data()
    data.loc[1, "Date"] = data.loc[0, "Date"]

    monkeypatch.setattr(
        service,
        "fetch_market_history",
        lambda **kwargs: data,
    )

